{
	"name": "n8n-nodes-transcriptyt",
	"version": "0.1.1",
	"description": "n8n node for TranscriptYT: YouTube transcripts (any language, AI fallback), batch and playlist transcripts, YouTube search, and video summaries.",
	"license": "MIT",
	"homepage": "https://transcript-yt.com",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"youtube",
		"transcript",
		"captions",
		"subtitles",
		"youtube-transcript"
	],
	"author": {
		"name": "TranscriptYT",
		"email": "aadit@techiseasy.co.in"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/aaditsshah25/n8n-nodes-transcriptyt.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TranscriptYtApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/TranscriptYt/TranscriptYt.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.9.10",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
